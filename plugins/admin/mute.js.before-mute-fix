// plugins/كتم.js - كتم / فك كتم 🔇
let handler = async (m, { conn, command, text, isAdmin, isOwner, isROwner }) => {
    // 1. التحقق من الصلاحيات
    if (!isAdmin && !isOwner) return conn.reply(m.chat, '*[❗] هذا الأمر مخصص للمشرفين فقط!*', m)

    // 2. تحديد العضو المستهدف (منشن > رد > رقم)
    let target;
    if (m.mentionedJid && m.mentionedJid[0]) {
        target = m.mentionedJid[0];
    } else if (m.quoted && m.quoted.sender) {
        target = m.quoted.sender;
    } else if (text) {
        let number = text.replace(/[^0-9]/g, '');
        if (number.length >= 11 && number.length <= 13) {
            target = number + '@s.whatsapp.net';
        } else {
            return conn.reply(m.chat, `*[ ⚠️ ] الرقم غير صحيح!*`, m);
        }
    }

    // 3. إذا لم يتم تحديد أي شخص
    if (!target) return conn.reply(m.chat, `𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦┤
│
│ ❄️ *الاسـتـخـدام الـصـحـيـح:*
│
├ׁ̟̇˚₊· ͟͟͞͞➳❥ كتم @منشن
├ׁ̟̇˚₊· ͟͟͞͞➳❥ كتم (بالرد على رسالة)
├ׁ̟̇˚₊· ͟͟͞͞➳❥ كتم 2012xxxx
│
𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦╯`, m);

    // 4. منع كتم المطور
    if (isROwner && (target === conn.user.jid || (global.owner || []).some(o => (o + "@s.whatsapp.net") === target || o.includes(target.split('@')[0])))) {
        return conn.reply(m.chat, `𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦┤
│
│ لا يمكن كتم المطور ي حب 🍻🥂
│
𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦╯`, m);
    }

    // 5. تجهيز قائمة الكتم
    if (!global.db.data.chats[m.chat]) global.db.data.chats[m.chat] = {};
    let chat = global.db.data.chats[m.chat];
    if (!chat.mute) chat.mute = [];
    let muteList = chat.mute;

    let isMuted = muteList.includes(target);

    // 6. أمر الكتم
    if (command === "كتم") {
        if (isMuted) {
            let msg = `   ⃝⃘︢︣֟፝ · ͟͟͞͞𝑴𝑨𝑿 𝑩𝑶𝑻 ͟͟͞͞➳ ꧁༒☬ 𝑴𝑨𝑿 𝑩𝑶𝑻 ☬༒꧂
𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦┤
│
│ ❄️ *الـعـضـو مـكـتـوم بـالـفـعـل*
│
│ ❄️ ═══════════════ ❄️
├ׁ̟̇˚₊· ͟͟͞͞➳❥ الـمـكـتـوم: @${target.split('@')[0]}
├ׁ̟̇˚₊· ͟͟͞͞➳❥ بـواسـطـة: @${m.sender.split('@')[0]}
│
│ 🩸 *الـعـضـو ده أخـد اسـتـراحـة إجـبـاريـة*
│
𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦╯`;
            return conn.sendMessage(m.chat, { text: msg, mentions: [target, m.sender] }, { quoted: m });
        }
        
        muteList.push(target);
        
        let msg = `*تم الكتم قطعنا ايده 🍻🥂`;
        
        await conn.sendMessage(m.chat, { text: msg, mentions: [target, m.sender] }, { quoted: m });
    }

    // 7. أمر فك الكتم
    else if (command === "فك_كتم") {
        if (!isMuted) {
            return conn.reply(m.chat, `𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦┤
│
│ ❌ *@${target.split('@')[0]} لـيـس مـكـتـومـاً!*
│
𓉘᳟ี ⃞̸͢𑁃 ̚𓉝᳟ี ͟͟͞͞┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦┄꯭๋━┄꫶︦━┄꫶︦┄꯭๋━┄꯭๋━┄꫶︦╯`, m, { mentions: [target] });
        }
        
        chat.mute = muteList.filter(id => id !== target);
        
        let msg = `*تم فك الكتم اتفضل صدعنا 🥂🍻*`;
        
        await conn.sendMessage(m.chat, { text: msg, mentions: [target, m.sender] }, { quoted: m });
    }
};

// 8. منع المكتوم من إرسال الرسائل
handler.before = async function (m, { conn, isAdmin, isOwner, isROwner }) {
    if (!m.isGroup) return;
    if (isAdmin || isOwner || isROwner) return;
    
    let chat = global.db.data.chats[m.chat];
    if (!chat?.mute || chat.mute.length === 0) return;
    
    if (chat.mute.includes(m.sender)) {
        await conn.sendMessage(m.chat, { delete: m.key });
        return true; // يمنع تنفيذ أي أمر تاني
    }
};

handler.help = ['كتم', 'فك_كتم'];
handler.tags = ['admin'];
handler.command = /^(كتم|فك_كتم)$/i;
handler.group = true;
handler.admin = true;

export default handler;