const PROMOTE_TRACKER = new Map()
const PROMOTE_LIMIT = 2
const PROMOTE_WINDOW = 5 * 60 * 1000

function trackPromote(chatId, actorJid) {
    const key = `${chatId}:${actorJid}`
    const now = Date.now()
    let entry = PROMOTE_TRACKER.get(key)
    if (!entry || (now - entry.start) > PROMOTE_WINDOW) {
        entry = { count: 0, start: now }
    }
    entry.count++
    PROMOTE_TRACKER.set(key, entry)
    return entry.count
}

function resetPromote(chatId, actorJid) {
    PROMOTE_TRACKER.delete(`${chatId}:${actorJid}`)
}

