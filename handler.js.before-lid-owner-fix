export async function groupsUpdate(groupsUpdate) {
    if (opts['self']) return
    if (global.db.data == null) await global.loadDatabase()

    for (const groupUpdate of groupsUpdate) {
        const id = groupUpdate.id
        if (!id) continue

        try {
            const prev = global.groupState[id] || {}
            const actorRaw = groupUpdate.author || groupUpdate.participant

            // ═══════════════════════════════════════════════════
            // 🎯 أول مرة نشوف الجروب ده → نحفظ الحالة ومش نرسل
            // ═══════════════════════════════════════════════════
            if (!global.groupInit[id]) {
                global.groupInit[id] = true
                global.groupState[id] = {
                    subject: groupUpdate.subject,
                    desc: groupUpdate.desc,
                    icon: groupUpdate.icon,
                    revoke: groupUpdate.revoke,
                    announce: groupUpdate.announce,
                    memberAddMode: groupUpdate.memberAddMode,
                    joinApprovalMode: groupUpdate.joinApprovalMode,
                    restrict: groupUpdate.restrict
                }
                console.log('[groupsUpdate] 🆕 initial state saved for', id)
                continue
            }

            // ═══════════════════════════════════════════════════
            // 🎯 لو مفيش actor → event وهمي من النظام → تجاهل
            // ═══════════════════════════════════════════════════
            if (!actorRaw) {
                console.log('[groupsUpdate] ⏭️ no actor — skip (system event)')
                // بس نحدّث الحالة عشان المرة الجاية
                global.groupState[id] = {
                    subject: groupUpdate.subject ?? prev.subject,
                    desc: groupUpdate.desc ?? prev.desc,
                    icon: groupUpdate.icon ?? prev.icon,
                    revoke: groupUpdate.revoke ?? prev.revoke,
                    announce: groupUpdate.announce ?? prev.announce,
                    memberAddMode: groupUpdate.memberAddMode ?? prev.memberAddMode,
                    joinApprovalMode: groupUpdate.joinApprovalMode ?? prev.joinApprovalMode,
                    restrict: groupUpdate.restrict ?? prev.restrict
                }
                continue
            }

            const changes = {}

            if (typeof groupUpdate.subject === 'string' && groupUpdate.subject !== prev.subject) {
                changes.subject = groupUpdate.subject
            }
            if (typeof groupUpdate.desc === 'string' && groupUpdate.desc !== prev.desc) {
                changes.desc = groupUpdate.desc
            }
            if (groupUpdate.icon !== undefined && groupUpdate.icon !== prev.icon) {
                changes.icon = groupUpdate.icon
            }
            if (groupUpdate.revoke !== undefined && groupUpdate.revoke !== prev.revoke) {
                changes.revoke = groupUpdate.revoke
            }
            if (typeof groupUpdate.announce !== 'undefined' && groupUpdate.announce !== prev.announce) {
                changes.announce = groupUpdate.announce
            }
            if (typeof groupUpdate.memberAddMode !== 'undefined' && groupUpdate.memberAddMode !== prev.memberAddMode) {
                changes.memberAddMode = groupUpdate.memberAddMode
            }
            if (typeof groupUpdate.joinApprovalMode !== 'undefined' && groupUpdate.joinApprovalMode !== prev.joinApprovalMode) {
                changes.joinApprovalMode = groupUpdate.joinApprovalMode
            }
            if (typeof groupUpdate.restrict !== 'undefined' && groupUpdate.restrict !== prev.restrict) {
                changes.restrict = groupUpdate.restrict
            }

            global.groupState[id] = {
                subject: groupUpdate.subject ?? prev.subject,
                desc: groupUpdate.desc ?? prev.desc,
                icon: groupUpdate.icon ?? prev.icon,
                revoke: groupUpdate.revoke ?? prev.revoke,
                announce: groupUpdate.announce ?? prev.announce,
                memberAddMode: groupUpdate.memberAddMode ?? prev.memberAddMode,
                joinApprovalMode: groupUpdate.joinApprovalMode ?? prev.joinApprovalMode,
                restrict: groupUpdate.restrict ?? prev.restrict
            }

            const changeKeys = Object.keys(changes)
            console.log('[groupsUpdate] changes:', changeKeys)

            if (changeKeys.length === 0) continue

            let actorMention = { text: 'النظام', jid: null }
            try {
